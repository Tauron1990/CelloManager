<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <UseWpf>true</UseWpf>
        <TargetFramework>net11.0-windows</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <OutputType>WinExe</OutputType>
        <AssemblyName>CelloManager</AssemblyName>
        <ApplicationIcon>4945342_document_documents_files_folder_format_icon.ico</ApplicationIcon>
        <LangVersion>default</LangVersion>

        <TrimMode>partial</TrimMode>
        <_SuppressWpfTrimError>true</_SuppressWpfTrimError>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2"/>
        <PackageReference Include="Avalonia.Desktop" Version="12.2.0" />
        <PackageReference Include="Meziantou.Analyzer" Version="3.0.342">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="QuestPDF" Version="2026.9.2" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Reimpl\CelloManager.Avalonia\CelloManager.Avalonia.csproj"/>
    </ItemGroup>

</Project>
