<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:data="clr-namespace:CelloManager.Core.Data"
             xmlns:controls="clr-namespace:Material.Styles.Controls;assembly=Material.Styles"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             HorizontalAlignment="Center"
             x:Class="CelloManager.Views.Orders.PendingOrderView">
    <controls:Card>
        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto,*,Auto">
            <TextBlock Name="OrderTime" Margin="5" Padding="5" Grid.Row="0" Grid.ColumnSpan="3" />
            <Button Name="PrintOrder" Margin="5" Padding="5" Grid.Row="0" Grid.Column="3">Drucken</Button>
            <Expander Header="Spulen" Margin="5" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4">
                <ItemsControl Name="SpoolList">
                    <ItemsControl.DataTemplates>
                        <DataTemplate DataType="data:OrderedSpoolList">
                            <StackPanel>
                                <TextBlock Text="{Binding Category}" />
                                <ItemsControl ItemsSource="{Binding Spools}" />
                            </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="data:OrderedSpool">
                            <StackPanel Orientation="Horizontal" Margin="5">
                                <TextBlock Margin="5" Text="{Binding Name, StringFormat='Name: {0}'}" />
                                <TextBlock Margin="5" Text="{Binding Amount, StringFormat='Menge: {0}'}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.DataTemplates>
                </ItemsControl>
            </Expander>
            <Button Name="Delete" Margin="5,5,0,5" Padding="5" CornerRadius="5,0,0,5" Grid.Row="2" Grid.Column="0">Löschen</Button>
            <Button Name="Commit" Margin="0,5,5,5" Padding="5" CornerRadius="0,5,5,0" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3">Bestätigen</Button>
        </Grid>
    </controls:Card>
</UserControl>